# Contact form email delivery
#
# The contact form at /contact posts to /api/contact, which uses Resend
# (https://resend.com) to deliver enquiries by email. Until both variables
# below are set, the API route returns a clear "not yet connected" error
# instead of pretending to send mail.

# Resend API key (from https://resend.com/api-keys). Required.
RESEND_API_KEY=

# Destination inbox for enquiries. Required.
CONTACT_EMAIL=satyajith.palliyil@gmail.com

# Sender address used in the "From" header. Must be a verified domain/sender
# in your Resend account. Until a domain is verified, Resend's shared
# onboarding@resend.dev sender can only deliver to the Resend account's own
# owner email — it will not reliably reach arbitrary recipients in production.
# Optional; falls back to "Tropical Digital Website <onboarding@resend.dev>".
EMAIL_FROM="Tropical Digital Website <onboarding@resend.dev>"
